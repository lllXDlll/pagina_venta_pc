// Modelo de datos: docs/00_parte_tecnica.md, sección 4.
// Modelos en PascalCase mapeados a tablas en español y snake_case.
// Las migraciones solo agregan (regla expand/contract, sección 6).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  CLIENTE
  ADMIN
}

enum EstadoUsuario {
  ACTIVO
  BLOQUEADO
}

enum TipoProducto {
  COMPONENTE
  EQUIPO
}

enum OrigenConfiguracion {
  MANUAL
  IA
}

enum EstadoConfiguracion {
  BORRADOR
  VALIDA
  INVALIDA
}

enum EstadoReserva {
  ACTIVA
  CONFIRMADA
  EXPIRADA
}

model Usuario {
  id             String        @id @default(uuid()) @db.Uuid
  correo         String        @unique
  hashContrasena String        @map("hash_contrasena")
  rol            Rol           @default(CLIENTE)
  estado         EstadoUsuario @default(ACTIVO)
  creadoEn       DateTime      @default(now()) @map("creado_en")

  sesiones        Sesion[]
  configuraciones Configuracion[]
  carrito         Carrito?
  reservas        Reserva[]
  ordenes         Orden[]
  notificaciones  Notificacion[]
  usosAsistente   UsoAsistente[]

  @@map("usuarios")
}

model Sesion {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  venceEn   DateTime @map("vence_en")
  revocada  Boolean  @default(false)
  creadoEn  DateTime @default(now()) @map("creado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([venceEn])
  @@map("sesiones")
}

model Categoria {
  id     String @id @default(uuid()) @db.Uuid
  nombre String @unique

  productos Producto[]

  @@map("categorias")
}

model Producto {
  id                String       @id @default(uuid()) @db.Uuid
  categoriaId       String       @map("categoria_id") @db.Uuid
  nombre            String
  tipo              TipoProducto
  precio            Decimal      @db.Decimal(12, 2)
  activo            Boolean      @default(true)
  atributosTecnicos Json         @default("{}") @map("atributos_tecnicos") @db.JsonB
  creadoEn          DateTime     @default(now()) @map("creado_en")

  categoria          Categoria           @relation(fields: [categoriaId], references: [id])
  stock              Stock?
  configuracionItems ConfiguracionItem[]
  carritoItems       CarritoItem[]
  reservaItems       ReservaItem[]
  ordenItems         OrdenItem[]

  @@index([categoriaId])
  @@map("productos")
}

model Stock {
  productoId     String @id @map("producto_id") @db.Uuid
  cantidadFisica Int    @map("cantidad_fisica")
  /// Bloqueo optimista: la confirmación descuenta con `cantidad >= n AND version = v`
  version        Int    @default(0)

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@map("stock")
}

model ReglaCompatibilidad {
  id         String  @id @default(uuid()) @db.Uuid
  /// SOCKET, RAM, POTENCIA, DIMENSIONES, FACTOR_FORMA, ALMACENAMIENTO
  codigo     String  @unique
  parametros Json    @default("{}") @db.JsonB
  activa     Boolean @default(true)

  @@map("reglas_compatibilidad")
}

model Configuracion {
  id          String              @id @default(uuid()) @db.Uuid
  usuarioId   String              @map("usuario_id") @db.Uuid
  origen      OrigenConfiguracion
  presupuesto Decimal?            @db.Decimal(12, 2)
  uso         String?
  estado      EstadoConfiguracion @default(BORRADOR)
  creadoEn    DateTime            @default(now()) @map("creado_en")

  usuario      Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  items        ConfiguracionItem[]
  carritoItems CarritoItem[]

  @@index([usuarioId])
  @@map("configuraciones")
}

model ConfiguracionItem {
  id              String @id @default(uuid()) @db.Uuid
  configuracionId String @map("configuracion_id") @db.Uuid
  productoId      String @map("producto_id") @db.Uuid
  cantidad        Int    @default(1)

  configuracion Configuracion @relation(fields: [configuracionId], references: [id], onDelete: Cascade)
  producto      Producto      @relation(fields: [productoId], references: [id])

  @@index([configuracionId])
  @@map("configuracion_items")
}

model Carrito {
  id            String   @id @default(uuid()) @db.Uuid
  usuarioId     String   @unique @map("usuario_id") @db.Uuid
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  usuario Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  items   CarritoItem[]

  @@map("carritos")
}

/// Un ítem es un producto o una configuración, nunca ambos ni ninguno
/// (CHECK `carrito_items_producto_o_configuracion`, añadido a mano en la migración).
model CarritoItem {
  id              String  @id @default(uuid()) @db.Uuid
  carritoId       String  @map("carrito_id") @db.Uuid
  productoId      String? @map("producto_id") @db.Uuid
  configuracionId String? @map("configuracion_id") @db.Uuid
  cantidad        Int     @default(1)

  carrito       Carrito        @relation(fields: [carritoId], references: [id], onDelete: Cascade)
  producto      Producto?      @relation(fields: [productoId], references: [id], onDelete: Restrict)
  configuracion Configuracion? @relation(fields: [configuracionId], references: [id], onDelete: Cascade)

  @@index([carritoId])
  @@map("carrito_items")
}

model Reserva {
  id        String        @id @default(uuid()) @db.Uuid
  usuarioId String        @map("usuario_id") @db.Uuid
  estado    EstadoReserva @default(ACTIVA)
  venceEn   DateTime      @map("vence_en")
  creadoEn  DateTime      @default(now()) @map("creado_en")

  usuario Usuario       @relation(fields: [usuarioId], references: [id])
  items   ReservaItem[]
  orden   Orden?

  @@index([estado, venceEn])
  @@index([usuarioId])
  @@map("reservas")
}

model ReservaItem {
  id         String @id @default(uuid()) @db.Uuid
  reservaId  String @map("reserva_id") @db.Uuid
  productoId String @map("producto_id") @db.Uuid
  cantidad   Int

  reserva  Reserva  @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@index([reservaId])
  @@map("reserva_items")
}

model Orden {
  id                String   @id @default(uuid()) @db.Uuid
  usuarioId         String   @map("usuario_id") @db.Uuid
  reservaId         String?  @unique @map("reserva_id") @db.Uuid
  /// Encabezado Idempotency-Key: un reintento devuelve la orden original
  claveIdempotencia String   @unique @map("clave_idempotencia")
  total             Decimal  @db.Decimal(12, 2)
  creadoEn          DateTime @default(now()) @map("creado_en")

  usuario     Usuario      @relation(fields: [usuarioId], references: [id])
  reserva     Reserva?     @relation(fields: [reservaId], references: [id])
  items       OrdenItem[]
  comprobante Comprobante?

  @@index([usuarioId, creadoEn])
  @@map("ordenes")
}

model OrdenItem {
  id             String  @id @default(uuid()) @db.Uuid
  ordenId        String  @map("orden_id") @db.Uuid
  productoId     String  @map("producto_id") @db.Uuid
  cantidad       Int
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(12, 2)

  orden    Orden    @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@index([ordenId])
  @@map("orden_items")
}

model Comprobante {
  id      String   @id @default(uuid()) @db.Uuid
  /// Número correlativo visible para el cliente (los ID son UUID)
  numero  Int      @unique @default(autoincrement())
  ordenId String   @unique @map("orden_id") @db.Uuid
  fecha   DateTime @default(now())
  detalle Json     @db.JsonB

  orden Orden @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  @@map("comprobantes")
}

model Notificacion {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  tipo      String
  mensaje   String
  leida     Boolean  @default(false)
  creadoEn  DateTime @default(now()) @map("creado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, leida])
  @@map("notificaciones")
}

model UsoAsistente {
  id          String   @id @default(uuid()) @db.Uuid
  usuarioId   String   @map("usuario_id") @db.Uuid
  presupuesto Decimal  @db.Decimal(12, 2)
  uso         String
  resultado   String
  latenciaMs  Int      @map("latencia_ms")
  usoRespaldo Boolean  @default(false) @map("uso_respaldo")
  creadoEn    DateTime @default(now()) @map("creado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  /// El límite del asistente cuenta las filas del usuario en las últimas 24 h
  @@index([usuarioId, creadoEn])
  @@map("uso_asistente")
}
