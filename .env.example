# Copiar a .env (en la raíz del repositorio) y ajustar. Nunca versionar .env.
# Los valores de ejemplo apuntan a los servicios de docker-compose.yml.

# --- API ---
PORT=3001

# Postgres. En producción, DATABASE_URL es el pooler de Neon y DIRECT_URL la conexión directa.
# connect_timeout (segundos, 30 por defecto) da tiempo a que Neon despierte tras suspenderse.
DATABASE_URL=postgresql://xdtech:xdtech@localhost:5432/xdtech?connect_timeout=30
DIRECT_URL=postgresql://xdtech:xdtech@localhost:5432/xdtech

# Redis. En producción, la URL rediss:// (TLS) de Upstash.
REDIS_URL=redis://localhost:6379

# Sesión y CORS. En local la cookie va sin Domain; en producción COOKIE_DOMAIN=.xdtech.store
COOKIE_DOMAIN=
FRONTEND_ORIGIN=http://localhost:3000
SESSION_TTL_DAYS=7

# Número de proxies delante de la API cuya X-Forwarded-For se acepta (Render: verificado en el Sprint 0)
TRUST_PROXY_HOPS=1

# Endpoints temporales /diagnostico (solo Sprint 0, HU-36b)
DIAGNOSTICO_HABILITADO=false

# Aplicar migraciones al arrancar (start.sh). true solo en Render.
MIGRAR_AL_ARRANCAR=false

# --- Web ---
# Next.js lee sus variables de apps/web/.env.local (en local) o de Vercel. Se fija en el build.
# Sin definir, apunta a http://localhost:3001. En producción: https://api.xdtech.store
NEXT_PUBLIC_API_URL=http://localhost:3001
